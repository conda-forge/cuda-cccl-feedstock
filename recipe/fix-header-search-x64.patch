diff --git a/lib/cmake/cub/cub-header-search.cmake b/lib/cmake/cub/cub-header-search.cmake
index 74d71b3..c72c2fd 100644
--- a/lib/cmake/cub/cub-header-search.cmake
+++ b/lib/cmake/cub/cub-header-search.cmake
@@ -2,14 +2,14 @@
 unset(_CUB_VERSION_INCLUDE_DIR CACHE) # Clear old result to force search
 
 # Find CMAKE_INSTALL_INCLUDEDIR=include directory"
-set(from_install_prefix "../../../")
+set(from_install_prefix "../../../../../Library/include/targets/x64")
 
 find_path(_CUB_VERSION_INCLUDE_DIR cub/version.cuh
   REQUIRED
   NO_CMAKE_FIND_ROOT_PATH # Don't allow CMake to re-root the search
   NO_DEFAULT_PATH # Only search explicit paths below:
   PATHS
-    "${CMAKE_CURRENT_LIST_DIR}/${from_install_prefix}/include"
-    "${CMAKE_CURRENT_LIST_DIR}/${from_install_prefix}/include/cccl"
+    "${CMAKE_CURRENT_LIST_DIR}/${from_install_prefix}"
+    "${CMAKE_CURRENT_LIST_DIR}/${from_install_prefix}/cccl"
 )
 set_property(CACHE _CUB_VERSION_INCLUDE_DIR PROPERTY TYPE INTERNAL)
